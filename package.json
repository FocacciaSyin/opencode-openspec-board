{
  "name": "opencode-openspec-board",
  "version": "0.2.0",
  "description": "OpenCode TUI and Desktop plugin: OpenSpec progress and a task board that can start apply or archive",
  "type": "module",
  "engines": { "node": ">=26.4.0" },
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx",
    "./gui-experimental": "./build/gui.cjs"
  },
  "files": ["index.ts", "tui.tsx", "board.ts", "rpc.ts", "build/gui.cjs"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FocacciaSyin/opencode-openspec-board.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openspec",
    "tui"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test *.test.ts",
    "build": "vite build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0 <2.3.0",
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/node": "^26.6.3",
    "solid-js": "1.9.12",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  },
  "overrides": {
    "seroval": "1.6.11"
  }
}
